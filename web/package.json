{
  "name": "@canopy/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "contracts": "bun scripts/generate-contracts.ts",
    "contracts:check": "bun scripts/generate-contracts.ts --check",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "fixtures:core": "python3.12 scripts/export-core-fixtures.py",
    "fixtures:advisor": "python3.12 scripts/export-advisor-fixture.py",
    "benchmark:core": "python3.12 scripts/export-core-fixtures.py --benchmark",
    "fixtures:benchmarks": "python3.12 scripts/export-benchmark-fixture.py",
    "fixtures:benchmarks:check": "python3.12 scripts/export-benchmark-fixture.py --check"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@xyflow/react": "^12.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/dagre": "^0.7.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "msw": "^2.11.0",
    "msw-storybook-addon": "^2.0.0",
    "storybook": "^10.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
