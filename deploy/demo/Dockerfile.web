# syntax=docker/dockerfile:1
FROM oven/bun:1.3.0 AS bun
FROM node:22.14.0-bookworm-slim AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web/ ./
COPY core/schemas/ /app/core/schemas/
# tsc and Vite run on the pinned Node version; Bun only resolves the lockfile.
RUN npm run build

FROM nginx:1.28.0-alpine
COPY deploy/demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist/ /usr/share/nginx/html/
# Preserve the core tree so relative evidence/schema/document links still work.
COPY core/ /usr/share/nginx/proof/
RUN mkdir -p /demo-fixtures /generated
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=6 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
