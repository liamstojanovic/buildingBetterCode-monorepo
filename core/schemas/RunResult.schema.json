{
  "$defs": {
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "reused",
            "blocked",
            "awaiting_approval",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "output": {
          "default": null,
          "title": "Output"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "source_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Run Id"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "step_id",
        "status"
      ],
      "title": "StepResult",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Cached Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "energy_j": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy J"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "tokens_known": {
          "default": false,
          "title": "Tokens Known",
          "type": "boolean"
        },
        "elapsed_known": {
          "default": false,
          "title": "Elapsed Known",
          "type": "boolean"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "baseline",
        "governed",
        "replay"
      ],
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "awaiting_approval",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "title": "Steps",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "evidence_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Evidence Versions",
      "type": "object"
    },
    "reused_steps": {
      "default": 0,
      "minimum": 0,
      "title": "Reused Steps",
      "type": "integer"
    },
    "invalidated_steps": {
      "default": 0,
      "minimum": 0,
      "title": "Invalidated Steps",
      "type": "integer"
    },
    "replay_source_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Source Run Id"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "tenant_id",
    "mode",
    "status",
    "started_at",
    "finished_at",
    "policy_version"
  ],
  "title": "RunResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
